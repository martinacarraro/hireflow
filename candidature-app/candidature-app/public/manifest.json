<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>Le faremo sapere — Logo</title>
<style>
  body { background: #111; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; font-family: sans-serif; color: white; gap: 32px; }
  .logo-wrap { display: flex; gap: 40px; align-items: center; flex-wrap: wrap; justify-content: center; }
  .size-label { text-align: center; margin-top: 8px; color: #888; font-size: 13px; }
  img { border-radius: 24%; }
</style>
</head>
<body>
  <h1 style="color:#C77DFF;letter-spacing:-0.5px">Le faremo sapere — Logo Preview</h1>
  <div class="logo-wrap">
    <div>
      <img src="logo_lefaremosapere.svg" width="256" height="256">
      <div class="size-label">512×512</div>
    </div>
    <div>
      <img src="logo_lefaremosapere.svg" width="128" height="128">
      <div class="size-label">256×256</div>
    </div>
    <div>
      <img src="logo_lefaremosapere.svg" width="96" height="96">
      <div class="size-label">192×192</div>
    </div>
    <div>
      <img src="logo_lefaremosapere.svg" width="48" height="48">
      <div class="size-label">96×96</div>
    </div>
  </div>
  <p style="color:#666;font-size:13px">SVG vettoriale — scalabile a qualsiasi dimensione</p>
</body>
</html>
